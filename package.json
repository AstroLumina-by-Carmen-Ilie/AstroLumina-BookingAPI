{
  "name": "astrolumina-booking-api",
  "version": "2.0.0",
  "description": "Cal.com Booking API for AstroLumina — astrological session scheduling",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules && rm -rf dist",
    "d1:migrate": "tsx src/db/migrate.ts",
    "render-build": "npm run clean && npm install --include=dev && npm run build",
    "update": "npm update --ignore-scripts",
    "install": "npm install --include=dev",
    "c_u_i_b_d": "npm run clean && npm run update && npm run install && npm run build && npm run dev"
  },
  "dependencies": {
    "@sentry/node": "^10.45.0",
    "@sentry/profiling-node": "^8.55.0",
    "axios": "^1.13.6",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "resend": "^6.10.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
